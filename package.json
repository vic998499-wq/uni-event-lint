{
  "name": "uni-event-lint",
  "version": "0.1.0",
  "description": "找出 uni-app 里「从事件的 target 取 value」这类静默失效的写法 —— 页面不报错、单测也照样绿的那一类 bug",
  "type": "module",
  "bin": {
    "uni-event-lint": "bin/cli.js"
  },
  "exports": {
    ".": "./src/scan.js"
  },
  "files": [
    "src",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/scan.test.js",
    "selfcheck": "node bin/cli.js test/fixtures/ok --exit-zero"
  },
  "keywords": [
    "uni-app",
    "uniapp",
    "vue",
    "lint",
    "miniprogram",
    "小程序",
    "detail.value",
    "target.value"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "typescript": "^5.0.0"
  }
}
